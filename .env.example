GT_LLM_BASE_URL=https://litellm.tail5d39b4.ts.net/v1
GT_LLM_API_KEY=replace-with-litellm-master-key
GT_LLM_MODEL=nemotron-bolt

# App auth (single owner; startup fails without these)
GT_APP_USERNAME=owner
GT_APP_PASSWORD=replace-with-strong-password

# Encrypted case store: 32-byte Base64 AES-GCM key
GT_CASE_ENCRYPTION_KEY=replace-with-base64-32-byte-key
GT_CASE_DB_PATH=game-cases.sqlite3

# Solver worker budgets
GT_EXACT_SOLVER_TIMEOUT_SECONDS=30
GT_ESTIMATION_TIMEOUT_SECONDS=120
GT_APPROX_SOLVER_TIMEOUT_SECONDS=120
GT_ANALYSIS_BUDGET_SECONDS=300
GT_MAX_STACKELBERG_ACTIONS=12
GT_MAX_EXACT_LP_VARIABLES=2000
GT_MAX_EXACT_LP_CONSTRAINTS=10000
GT_MAX_SIMPDIV_LEASH=10000
GT_MAX_SOLVER_WORKERS=1

# Public sharing (worker: share_worker/ on share.jakub.team; links expire in 90 days)
GT_SHARE_TOKEN=replace-with-share-worker-token
GT_SHARE_ENDPOINT=https://share.jakub.team/api/share
